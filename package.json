{
  "name": "godot-mcp",
  "version": "0.2.0",
  "description": "MCP server for interfacing with Godot game engine. Provides tools for launching the editor, running projects, and capturing debug output.",
  "keywords": [
    "godot",
    "mcp",
    "ai",
    "claude",
    "cline"
  ],
  "homepage": "https://github.com/0xc0re/godot-mcp",
  "bugs": {
    "url": "https://github.com/0xc0re/godot-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/0xc0re/godot-mcp.git"
  },
  "license": "MIT",
  "author": "Christopher Story <chris@nctcog.io>",
  "contributors": [
    "Solomon Elias <solomon@sippy.ai> (original author, Coding-Solo/godot-mcp)"
  ],
  "type": "module",
  "bin": {
    "godot-mcp": "./build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build.js",
    "inspector": "npx @modelcontextprotocol/inspector build/index.js",
    "prepare": "npm run build",
    "start": "./start.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "watch": "tsc --watch -p tsconfig.build.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "fs-extra": "^11.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "typescript": "^5.3.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
